{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=ecommerce;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },

  "RefreshToken": {
    "LifetimeDays": 7,
    "GraceSeconds": 5,
    "CookieName": "ecommerce_rt",
    "CookiePath": "/api/auth"
  },

  "Jwt": {
    "Key": "",
    "Issuer": "Store.API",
    "Audience": "Store.Client",
    "ExpiryMinutes": 15
  },

  "DataRetention": {
    "Enabled": true,
    "FirstRunDelayMinutes": 5,
    "IntervalHours": 24
  },

  "FileStorage": {
    "RootPath": "wwwroot"
  },

  "Fcm": {
    "ServiceAccountJson": ""
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromName": "StoreFront",
    "FromAddress": "no-reply@store.com"
  },

  "Paymob": {
    "ApiKey": "",
    "IntegrationIdCard": "",
    "IntegrationIdWallet": "",
    "IframeId": "",
    "HmacSecret": ""
  },

  "AllowedOrigins": [ "*" ],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
